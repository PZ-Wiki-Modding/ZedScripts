{
  "name": "project-zomboid-scripts",
  "displayName": "ZedScripts",
  "icon": "images/pz-script.png",
  "description": "A Visual Studio Code extension to aid in editing Project Zomboid script files, also known as ZedScripts.",
  "version": "1.10.9",
  "publisher": "SimKDT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "editor.semanticHighlighting.enabled": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pz-wiki-modding/ZedScripts"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/pz-wiki-modding/ZedScripts/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "ZedScripts",
      "properties": {
        "ZedScripts.searchDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "C:/Program Files (x86)/Steam/steamapps/common/ProjectZomboid/media/scripts/"
          ],
          "description": "Directories to search for the vanilla script files."
        },
        "ZedScripts.onlyUseLocalData": {
          "type": "boolean",
          "default": true,
          "description": "Whether to only use local data for scripts."
        },
        "ZedScripts.disabledDiagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of diagnostic IDs to disable."
        },
        "ZedScripts.disableAllDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Whether to disable all diagnostics."
        }
      }
    },
    "languages": [
      {
        "id": "ZedScripts",
        "aliases": [
          "ZedScripts",
          "pz-scripts"
        ],
        "configuration": "./language/ZedScripts-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ZedScripts",
        "scopeName": "source.pz-script",
        "path": "./syntaxes/ZedScripts.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "entity.name.recipe.pz": [
            "entity.name.recipe"
          ],
          "entity.name.item.pz": [
            "entity.name.item"
          ],
          "entity.name.recipe.name.pz": [
            "entity.name.recipe.name"
          ],
          "entity.name.item.name.pz": [
            "entity.name.item.name"
          ],
          "keyword.control.pz": [
            "keyword.control"
          ],
          "support.type.property-name.pz": [
            "support.type.property-name"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "ZedScripts.resetScriptCache",
        "title": "ZedScripts: Force fetch Scripts Data"
      },
      {
        "command": "ZedScripts.exportScriptBlocks",
        "title": "ZedScripts: Export to JSON"
      }
    ]
  },
  "scripts": {
    "postinstall": "node ./node_modules/vscode/bin/install",
    "test": "@vscode/test-cli",
    "test:jest": "jest tests",
    "check": "tsc --noEmit && npm run test",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "types": ["node", "jest"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
  },
  "include": [
    "src/**/*.ts",
    "src/pz-scripts-data/out/scriptBlocks.json"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}